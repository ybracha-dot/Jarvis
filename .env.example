# Jarvis configuration. Copy to .env. Names and meanings only: never commit real values.
# Everything is optional. The app launches and the example workspace works with none of these.

# Where data lives. Default: ./data  (demo/ and personal/ are separate folders inside it)
# JARVIS_DATA_DIR=

# Claude model provider for the APP. This is separate from Claude Code and from Claude chat.
# Without a key, council reviews fall back to a labeled sample replay or a rubric checklist.
# ANTHROPIC_API_KEY=
# Optional override for a proxy or test endpoint.
# ANTHROPIC_BASE_URL=

# Paid AI stays OFF until you set a budget above 0 (here or in Settings). Estimates, not billing.
# JARVIS_DAILY_BUDGET_USD=0

# Premium deep review needs this AND the Settings opt-in AND a confirmation per request.
# JARVIS_ALLOW_PREMIUM=0

# Override a role's model. Roles: EXTRACT_SMALL, BRIEF, STUDY_PLAN, ADVISOR, SKILL_CANDIDATE, ESSAY_REVIEW, COUNCIL_EDITOR, DEEP_REVIEW
# JARVIS_MODEL_BRIEF=claude-sonnet-5-5

# Rates used for cost ESTIMATES, per million tokens, as JSON. Defaults are copied from Anthropic's API reference table (cached 2026-11-03), not verified live.
# JARVIS_PRICES_JSON={"claude-sonnet-5-5":{"in":3,"out":15}}

# Read-only calendar feed: the secret iCal address from your calendar settings.
# JARVIS_ICS_URL=

# Which workspace the MCP server reads: demo (default) or personal.
# JARVIS_MCP_MODE=demo
